  "description": "G.V.R.M.Solutions Online Coaching Platform",
  "main": "main.js",
  "author": "G.V.R.M.Solutions",
  "scripts": { "start": "electron .", "build": "electron-builder --win" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.gvrm.coaching",
